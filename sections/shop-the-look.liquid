{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ShopTheLook-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media screen and (min-width: 750px) {
    #ShopTheLook-{{ section.id }} {
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
    }

    #ShopTheLook-{{ section.id }}.shop-the-look--image-right {
      grid-template-columns: 1fr 1.3fr;
    }

    #ShopTheLook-{{ section.id }}.shop-the-look--image-right .shop-the-look__media {
      order: 2;
    }
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__media {
    position: relative;
    overflow: hidden;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__products {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    text-decoration: none;
    color: rgb(var(--color-foreground));
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product-media {
    flex-shrink: 0;
    width: 8rem;
    height: 8rem;
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.04);
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product-title {
    font-size: 1.5rem;
    margin: 0 0 0.4rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endunless -%}

    <div
      id="ShopTheLook-{{ section.id }}"
      class="shop-the-look{% if section.settings.image_position == 'right' %} shop-the-look--image-right{% endif %}"
    >
      <div class="shop-the-look__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              widths: '450, 700, 900, 1100, 1500',
              sizes: '(min-width: 750px) 55vw, 100vw'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="shop-the-look__products">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <a
            href="{{ product.url | default: '#' }}"
            class="shop-the-look__product"
            {{ block.shopify_attributes }}
          >
            <div class="shop-the-look__product-media">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 200
                  | image_tag: loading: 'lazy', widths: '100, 160, 200'
                }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="shop-the-look__product-info">
              <p class="shop-the-look__product-title">{{ product.title | escape | default: 'Produto' }}</p>
              {%- if product != blank -%}
                {% render 'price', product: product %}
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comprar o Look",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Comprar o Look",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Médio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Tamanho do título"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem lifestyle"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        { "value": "left", "label": "Imagem à esquerda" },
        { "value": "right", "label": "Imagem à direita" }
      ],
      "default": "left",
      "label": "Posição da imagem (desktop)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comprar o Look",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
