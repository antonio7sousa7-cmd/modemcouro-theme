{%- comment -%}
  Secção de avaliações de clientes para a página de produto, com estética
  "silent luxury": fundo creme, cartões discretos com estrelas, citação em
  itálico e nome do cliente. As avaliações são blocos fixos (não ligados à
  app de reviews da Shopify) — os textos padrão vêm já escritos aqui e em
  templates/product*.json, e podem ser editados por produto no editor.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ProductReviews-{{ section.id }} .ss-reviews__heading {
    margin: 0 0 3rem;
    text-align: center;
    text-transform: uppercase;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 1.6rem;
    letter-spacing: 0.15em;
    color: rgb(var(--color-foreground));
  }

  #ProductReviews-{{ section.id }} .ss-reviews__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
  }

  @media screen and (min-width: 750px) {
    #ProductReviews-{{ section.id }} .ss-reviews__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  #ProductReviews-{{ section.id }} .ss-review-card {
    display: flex;
    flex-direction: column;
    padding: 2.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__stars {
    display: flex;
    gap: 0.2rem;
    margin-bottom: 1.4rem;
  }

  #ProductReviews-{{ section.id }} .ss-review-card__stars svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: #d4af37;
  }

  /* A classe fica no <span> que envolve a estrela "vazia" (rating < 5);
     o seletor tem de descer até ao svg lá dentro para lhe mudar o fill. */
  #ProductReviews-{{ section.id }} .ss-review-card__star--empty svg {
    fill: rgba(212, 175, 55, 0.25);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__quote {
    flex-grow: 1;
    margin: 0 0 1.6rem;
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground));
  }

  #ProductReviews-{{ section.id }} .ss-review-card__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: rgba(var(--color-foreground), 0.65);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__verified {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.3rem;
    height: 1.3rem;
  }

  #ProductReviews-{{ section.id }} .ss-review-card__verified svg {
    width: 100%;
    height: 100%;
  }
{%- endstyle -%}

<div id="ProductReviews-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ss-reviews__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="ss-reviews__list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'review' -%}
            <div class="ss-review-card" {{ block.shopify_attributes }}>
              <div class="ss-review-card__stars" role="img" aria-label="{{ block.settings.rating }} de 5 estrelas">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    {{- 'icon-star.svg' | inline_asset_content -}}
                  {%- else -%}
                    <span class="ss-review-card__star--empty">{{- 'icon-star.svg' | inline_asset_content -}}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <p class="ss-review-card__quote">&ldquo;{{ block.settings.review }}&rdquo;</p>
              <p class="ss-review-card__name">
                {{ block.settings.customer_name | escape }}
                <span class="ss-review-card__verified" role="img" aria-label="Comprador verificado">
                  {{- 'icon-tick.svg' | inline_asset_content -}}
                </span>
              </p>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Avaliações",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "O Que Dizem os Nossos Clientes"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avaliação",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Estrelas",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Texto da avaliação",
          "default": "Qualidade impressionante, recomendo."
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Nome do cliente",
          "default": "Cliente"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avaliações",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
