{%- comment -%}
  Secção de avaliações de clientes para a página de produto, com estética
  "silent luxury": fundo creme, cartões discretos com estrelas, citação em
  itálico e nome do cliente. As avaliações são blocos fixos (não ligados à
  app de reviews da Shopify) — os textos padrão vêm já escritos aqui e em
  templates/product*.json, e podem ser editados por produto no editor.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ProductReviews-{{ section.id }} .ss-reviews__heading {
    margin: 0 0 2.4rem;
    text-align: center;
    text-transform: uppercase;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 1.6rem;
    letter-spacing: 0.15em;
    color: rgb(var(--color-foreground));
  }

  /* Cabeçalho-resumo: nota média, distribuição de estrelas e botão. A média e
     as barras são calculadas a partir das próprias avaliações (blocos). */
  #ProductReviews-{{ section.id }} .ss-reviews__summary {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    align-items: center;
    justify-items: center;
    margin: 0 0 3.6rem;
    padding: 0 0 3.2rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    #ProductReviews-{{ section.id }} .ss-reviews__summary {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 4rem;
      justify-items: stretch;
      text-align: left;
    }
  }

  #ProductReviews-{{ section.id }} .ss-reviews__score {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  @media screen and (min-width: 750px) {
    #ProductReviews-{{ section.id }} .ss-reviews__score {
      align-items: flex-start;
    }
  }

  #ProductReviews-{{ section.id }} .ss-reviews__score-value {
    font-family: var(--font-heading-family);
    font-size: 5.2rem;
    line-height: 1;
    color: rgb(var(--color-foreground));
  }

  #ProductReviews-{{ section.id }} .ss-reviews__score-stars {
    position: relative;
    display: inline-flex;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__score-stars-row {
    display: flex;
    gap: 0.2rem;
  }

  /* Camada preenchida por cima da vazia, cortada à largura da média (ex. 92%). */
  #ProductReviews-{{ section.id }} .ss-reviews__score-stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__score-stars-fill .ss-reviews__score-stars-row {
    width: max-content;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__score-stars svg {
    display: block;
    flex-shrink: 0;
    width: 1.8rem;
    height: 1.8rem;
    fill: rgba(212, 175, 55, 0.25);
  }

  #ProductReviews-{{ section.id }} .ss-reviews__score-stars-fill svg {
    fill: #d4af37;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__count {
    margin: 0;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    color: rgba(var(--color-foreground), 0.65);
  }

  #ProductReviews-{{ section.id }} .ss-reviews__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.4rem;
    padding: 0.4rem 1.1rem 0.4rem 0.5rem;
    border: 1px solid rgba(212, 175, 55, 0.6);
    border-radius: 10rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 1.05rem;
    color: rgb(var(--color-foreground));
  }

  #ProductReviews-{{ section.id }} .ss-reviews__badge svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    padding: 0.3rem;
    border-radius: 50%;
    background: #d4af37;
    box-sizing: border-box;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__bars {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 100%;
    max-width: 42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__bar {
    display: grid;
    grid-template-columns: 2.6rem 1fr 2.4rem;
    align-items: center;
    gap: 1.2rem;
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  #ProductReviews-{{ section.id }} .ss-reviews__bar-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__bar-label svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: #d4af37;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__bar-track {
    height: 0.8rem;
    border-radius: 0.4rem;
    background: rgba(var(--color-foreground), 0.1);
    overflow: hidden;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__bar-fill {
    display: block;
    height: 100%;
    border-radius: 0.4rem;
    background: #d4af37;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__bar-count {
    text-align: right;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__write {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.6rem;
    padding: 0 3rem;
    border: 1px solid {{ section.settings.button_color }};
    background: {{ section.settings.button_color }};
    color: #fff;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.12em;
    font-size: 1.2rem;
    white-space: nowrap;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__write:hover,
  #ProductReviews-{{ section.id }} .ss-reviews__write:focus-visible {
    background: color-mix(in srgb, {{ section.settings.button_color }} 80%, #000);
    border-color: color-mix(in srgb, {{ section.settings.button_color }} 80%, #000);
    color: #fff;
  }

  /* Carrossel: scroll-snap nativo (arrasta com o dedo; o rato, as setas e os
     pontos são tratados pelo script no fim do ficheiro).
     --ss-full = cartões inteiros visíveis; --ss-peek = largura do cartão
     seguinte que fica à vista, cortado, a indicar que há mais para deslizar. */
  #ProductReviews-{{ section.id }} .ss-reviews__viewport {
    position: relative;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__list {
    --ss-gap: 1.6rem;
    --ss-full: 1;
    --ss-peek: 4rem;
    display: flex;
    gap: var(--ss-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding-bottom: 0.4rem;
    cursor: grab;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__list::-webkit-scrollbar {
    display: none;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__list.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  @media screen and (min-width: 750px) {
    #ProductReviews-{{ section.id }} .ss-reviews__list {
      --ss-gap: 2.4rem;
      --ss-full: 2;
      --ss-peek: 6rem;
    }
  }

  @media screen and (min-width: 990px) {
    #ProductReviews-{{ section.id }} .ss-reviews__list {
      --ss-gap: 3rem;
      --ss-full: 3;
      --ss-peek: 8rem;
    }
  }

  /* Setas circulares: só a partir de tablet (no telemóvel arrasta-se). */
  #ProductReviews-{{ section.id }} .ss-reviews__arrow {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    margin: -2.2rem 0 0;
    padding: 0;
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: 50%;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    box-shadow: 0 2px 10px rgba(var(--color-foreground), 0.12);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__arrow:hover {
    border-color: #d4af37;
    color: #d4af37;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__arrow[disabled] {
    opacity: 0;
    pointer-events: none;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__arrow--prev { left: -2.2rem; }
  #ProductReviews-{{ section.id }} .ss-reviews__arrow--next { right: -2.2rem; }

  #ProductReviews-{{ section.id }} .ss-reviews__arrow svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (min-width: 750px) {
    #ProductReviews-{{ section.id }} .ss-reviews__arrow {
      display: inline-flex;
    }
  }

  /* Pontos de paginação */
  #ProductReviews-{{ section.id }} .ss-reviews__dots {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2.4rem;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__dots[hidden] {
    display: none;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__dot {
    width: 0.8rem;
    height: 0.8rem;
    padding: 0;
    border: 0;
    border-radius: 0.4rem;
    background: rgba(var(--color-foreground), 0.2);
    cursor: pointer;
    transition: width 0.25s ease, background-color 0.25s ease;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__dot[aria-current="true"] {
    width: 2.4rem;
    background: #d4af37;
  }

  #ProductReviews-{{ section.id }} .ss-review-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((100% - var(--ss-gap) * var(--ss-full) - var(--ss-peek)) / var(--ss-full));
    box-sizing: border-box;
    scroll-snap-align: start;
    padding: 2.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__stars {
    display: flex;
    gap: 0.2rem;
    margin-bottom: 1.4rem;
  }

  /* Estrela preenchida: o icon-star.svg do tema é só contorno (path evenodd
     com "buraco"), por isso aqui usa-se um svg sólido próprio. A classe --empty
     fica no <span> à volta do svg, daí o seletor descer até ao svg. */
  #ProductReviews-{{ section.id }} .ss-review-card__stars svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: #d4af37;
  }

  #ProductReviews-{{ section.id }} .ss-review-card__star--empty svg {
    fill: rgba(212, 175, 55, 0.25);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__quote {
    flex-grow: 1;
    margin: 0 0 1.6rem;
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground));
  }

  #ProductReviews-{{ section.id }} .ss-review-card__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: rgba(var(--color-foreground), 0.65);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__verified {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.3rem;
    height: 1.3rem;
  }

  #ProductReviews-{{ section.id }} .ss-review-card__verified svg {
    width: 100%;
    height: 100%;
  }
{%- endstyle -%}

{%- liquid
  assign review_count = 0
  assign rating_total = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  assign c2 = 0
  assign c1 = 0
  for block in section.blocks
    if block.type == 'review'
      assign r = block.settings.rating
      assign review_count = review_count | plus: 1
      assign rating_total = rating_total | plus: r
      case r
        when 5
          assign c5 = c5 | plus: 1
        when 4
          assign c4 = c4 | plus: 1
        when 3
          assign c3 = c3 | plus: 1
        when 2
          assign c2 = c2 | plus: 1
        when 1
          assign c1 = c1 | plus: 1
      endcase
    endif
  endfor
  if review_count > 0
    assign average = rating_total | times: 1.0 | divided_by: review_count
    assign average_label = average | round: 1
    assign average_pct = average | times: 20.0 | round: 1
  endif
  assign write_link = section.settings.button_link
  if write_link == blank
    assign write_subject = 'Avaliação: ' | append: product.title | url_encode
    assign write_link = 'mailto:' | append: shop.email | append: '?subject=' | append: write_subject
  endif
-%}

{%- capture star_svg -%}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.2l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 15l-5.6 3.3 1.4-6.3L1 7.7l6.4-.6z"/></svg>
{%- endcapture -%}

<div id="ProductReviews-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ss-reviews__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if review_count > 0 -%}
      <div class="ss-reviews__summary">
        <div class="ss-reviews__score">
          <span class="ss-reviews__score-value">{{ average_label }}</span>
          <span class="ss-reviews__score-stars" role="img" aria-label="{{ average_label }} de 5 estrelas">
            <span class="ss-reviews__score-stars-row">
              {%- for i in (1..5) -%}{{ star_svg }}{%- endfor -%}
            </span>
            <span class="ss-reviews__score-stars-fill" style="width: {{ average_pct }}%">
              <span class="ss-reviews__score-stars-row">
                {%- for i in (1..5) -%}{{ star_svg }}{%- endfor -%}
              </span>
            </span>
          </span>
          <p class="ss-reviews__count">
            {{ review_count }} {% if review_count == 1 %}avaliação{% else %}avaliações{% endif %}
          </p>
          <span class="ss-reviews__badge">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-6.5"/></svg>
            Verificado
          </span>
        </div>

        <ul class="ss-reviews__bars" aria-label="Distribuição das avaliações">
          {%- for n in (1..5) reversed -%}
            {%- liquid
              case n
                when 5
                  assign n_count = c5
                when 4
                  assign n_count = c4
                when 3
                  assign n_count = c3
                when 2
                  assign n_count = c2
                else
                  assign n_count = c1
              endcase
              assign n_pct = n_count | times: 100.0 | divided_by: review_count | round: 1
            -%}
            <li class="ss-reviews__bar">
              <span class="ss-reviews__bar-label">{{ n }} {{ star_svg }}</span>
              <span class="ss-reviews__bar-track"><span class="ss-reviews__bar-fill" style="width: {{ n_pct }}%"></span></span>
              <span class="ss-reviews__bar-count">{{ n_count }}</span>
            </li>
          {%- endfor -%}
        </ul>

        <a class="ss-reviews__write" href="{{ write_link }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}

    <div class="ss-reviews__viewport">
      <button type="button" class="ss-reviews__arrow ss-reviews__arrow--prev" aria-label="Avaliações anteriores">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M12.5 4.5L7 10l5.5 5.5"/></svg>
      </button>
      <div class="ss-reviews__list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'review' -%}
              <div class="ss-review-card" {{ block.shopify_attributes }}>
                <div class="ss-review-card__stars" role="img" aria-label="{{ block.settings.rating }} de 5 estrelas">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.rating -%}
                      <span>{{ star_svg }}</span>
                    {%- else -%}
                      <span class="ss-review-card__star--empty">{{ star_svg }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="ss-review-card__quote">&ldquo;{{ block.settings.review }}&rdquo;</p>
                <p class="ss-review-card__name">
                  {{ block.settings.customer_name | escape }}
                  <span class="ss-review-card__verified" role="img" aria-label="Comprador verificado">
                    {{- 'icon-tick.svg' | inline_asset_content -}}
                  </span>
                </p>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      <button type="button" class="ss-reviews__arrow ss-reviews__arrow--next" aria-label="Avaliações seguintes">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7.5 4.5L13 10l-5.5 5.5"/></svg>
      </button>
    </div>
    <div class="ss-reviews__dots" role="group" aria-label="Paginação das avaliações" hidden></div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('ProductReviews-{{ section.id }}');
    if (!root) return;
    var list = root.querySelector('.ss-reviews__list');
    var prev = root.querySelector('.ss-reviews__arrow--prev');
    var next = root.querySelector('.ss-reviews__arrow--next');
    var dotsBox = root.querySelector('.ss-reviews__dots');
    var targets = [], dots = [], current = 0;

    // Posições de paragem: o início de cada cartão, limitado ao scroll máximo
    // (os últimos cartões já não conseguem chegar ao início da lista).
    function measure() {
      var max = list.scrollWidth - list.clientWidth;
      var origin = list.getBoundingClientRect().left - list.scrollLeft;
      targets = [];
      Array.prototype.forEach.call(list.children, function (card) {
        if (!card.classList.contains('ss-review-card')) return;
        var x = Math.min(Math.round(card.getBoundingClientRect().left - origin), max);
        x = Math.max(x, 0);
        if (targets.length === 0 || x - targets[targets.length - 1] > 4) targets.push(x);
      });
      if (max <= 4) targets = [0];
      dotsBox.innerHTML = '';
      dots = targets.map(function (x, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'ss-reviews__dot';
        b.setAttribute('aria-label', 'Ir para a avaliação ' + (i + 1));
        b.addEventListener('click', function () { goTo(i); });
        dotsBox.appendChild(b);
        return b;
      });
      dotsBox.hidden = targets.length < 2;
      update();
    }

    function goTo(i) {
      i = Math.max(0, Math.min(targets.length - 1, i));
      list.scrollTo({ left: targets[i], behavior: 'smooth' });
    }

    function update() {
      var best = 0;
      targets.forEach(function (x, i) {
        if (Math.abs(x - list.scrollLeft) < Math.abs(targets[best] - list.scrollLeft)) best = i;
      });
      current = best;
      dots.forEach(function (d, i) {
        if (i === best) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
      });
      prev.disabled = list.scrollLeft <= 4;
      next.disabled = list.scrollLeft >= list.scrollWidth - list.clientWidth - 4;
    }

    prev.addEventListener('click', function () { goTo(current - 1); });
    next.addEventListener('click', function () { goTo(current + 1); });
    list.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', measure);

    // Arrastar com o rato (o toque usa o scroll nativo).
    var startX = 0, startScroll = 0, down = false, moved = false;
    list.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      down = true; moved = false;
      startX = e.clientX; startScroll = list.scrollLeft;
    });
    window.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) { moved = true; list.classList.add('is-dragging'); }
      if (moved) list.scrollLeft = startScroll - dx;
    });
    window.addEventListener('pointerup', function () {
      if (!down) return;
      down = false;
      list.classList.remove('is-dragging'); // o snap volta a assentar no cartão mais próximo
    });
    list.addEventListener('dragstart', function (e) { e.preventDefault(); });

    measure();
    window.addEventListener('load', measure);
  })();
</script>

{% schema %}
{
  "name": "Avaliações",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Avaliações de Clientes"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Escrever uma avaliação"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão",
      "info": "Se ficar vazio, abre um email para o endereço da loja com o nome do produto."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Cor do botão",
      "default": "#5c4033"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
