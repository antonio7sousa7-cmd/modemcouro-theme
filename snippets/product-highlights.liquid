{%- comment -%}
  Lista de destaques do produto, mostrada por baixo do bloco de
  disponibilidade/envio ("Envios grátis com CTT"), reforçando os
  principais pontos de venda junto ao botão de compra.
{%- endcomment -%}

{%- style -%}
  .ss-product-highlights {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ss-product-highlights__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ss-product-highlights__item .svg-wrapper svg {
    width: 1.3rem;
    height: 1.3rem;
    flex-shrink: 0;
  }
{%- endstyle -%}

<ul class="ss-product-highlights list-unstyled" role="list">
  <li class="ss-product-highlights__item caption">
    <span class="svg-wrapper">{{- 'icon-tick.svg' | inline_asset_content -}}</span>
    Pele 100% genuína
  </li>
  <li class="ss-product-highlights__item caption">
    <span class="svg-wrapper">{{- 'icon-tick.svg' | inline_asset_content -}}</span>
    Fabricado em Portugal
  </li>
  <li class="ss-product-highlights__item caption">
    <span class="svg-wrapper">{{- 'icon-tick.svg' | inline_asset_content -}}</span>
    Devolução grátis até 14 dias
  </li>
  <li class="ss-product-highlights__item caption">
    <span class="svg-wrapper">{{- 'icon-tick.svg' | inline_asset_content -}}</span>
    Pagamento 100% seguro
  </li>
</ul>
