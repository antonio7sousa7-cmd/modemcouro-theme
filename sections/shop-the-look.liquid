{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ShopTheLook-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
  }

  @media screen and (min-width: 750px) {
    #ShopTheLook-{{ section.id }} {
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
      gap: 4rem;
    }

    #ShopTheLook-{{ section.id }}.shop-the-look--image-right {
      grid-template-columns: 1fr 1.3fr;
    }

    #ShopTheLook-{{ section.id }}.shop-the-look--image-right .shop-the-look__media {
      order: 2;
    }
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--product-card-corner-radius);
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__products-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: rgba(var(--color-foreground), 0.03);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    padding: 2.4rem;
  }

  @media screen and (min-width: 750px) {
    #ShopTheLook-{{ section.id }} .shop-the-look__products-panel {
      align-self: stretch;
      padding: 3.2rem;
    }
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__products {
    display: flex;
    flex-direction: column;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product {
    display: flex;
    align-items: center;
    gap: 2rem;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    padding: 2rem 0;
    transition: background-color var(--duration-short, 0.25s) ease;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product:not(:first-child) {
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product:hover,
  #ShopTheLook-{{ section.id }} .shop-the-look__product:focus-visible {
    background-color: rgba(var(--color-foreground), 0.04);
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product:focus-visible {
    outline: 2px solid rgba(var(--color-foreground), 0.5);
    outline-offset: -2px;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product-media {
    flex-shrink: 0;
    width: 9.6rem;
    height: 9.6rem;
    overflow: hidden;
    border-radius: var(--product-card-corner-radius);
    background-color: rgba(var(--color-foreground), 0.04);
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long, 0.5s) ease;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product:hover .shop-the-look__product-media img {
    transform: scale(1.06);
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__product-title {
    font-size: 1.6rem;
    margin: 0 0 0.6rem;
  }

  #ShopTheLook-{{ section.id }} .shop-the-look__empty {
    margin: 0;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 1.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    #ShopTheLook-{{ section.id }} .shop-the-look__product,
    #ShopTheLook-{{ section.id }} .shop-the-look__product-media img {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endunless -%}

    <div
      id="ShopTheLook-{{ section.id }}"
      class="shop-the-look{% if section.settings.image_position == 'right' %} shop-the-look--image-right{% endif %}"
    >
      <div class="shop-the-look__media">
        {%- if section.settings.image != blank -%}
          {%- assign lifestyle_alt = section.settings.image.alt | default: section.settings.heading | strip_html -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              widths: '450, 700, 900, 1100, 1500',
              sizes: '(min-width: 750px) 55vw, 100vw',
              alt: lifestyle_alt
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="shop-the-look__products-panel">
        {%- if section.blocks.size > 0 -%}
          <div class="shop-the-look__products">
            {%- for block in section.blocks -%}
              {%- assign product = block.settings.product -%}
              <a
                href="{{ product.url | default: '#' }}"
                class="shop-the-look__product"
                {{ block.shopify_attributes }}
              >
                <div class="shop-the-look__product-media">
                  {%- if product.featured_image != blank -%}
                    {%- assign product_alt = product.featured_image.alt | default: product.title | strip_html -%}
                    {{
                      product.featured_image
                      | image_url: width: 200
                      | image_tag: loading: 'lazy', widths: '100, 160, 200', alt: product_alt
                    }}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="shop-the-look__product-info">
                  <p class="shop-the-look__product-title">{{ product.title | escape | default: 'Produto' }}</p>
                  {%- if product != blank -%}
                    {% render 'price', product: product %}
                  {%- endif -%}
                </div>
              </a>
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="shop-the-look__empty">Escolhe os produtos deste look no editor de temas.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comprar o Look",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Comprar o Look",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Médio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Tamanho do título"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem lifestyle"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        { "value": "left", "label": "Imagem à esquerda" },
        { "value": "right", "label": "Imagem à direita" }
      ],
      "default": "left",
      "label": "Posição da imagem (desktop)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comprar o Look",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
