{% style %}
  .ss-announcement-{{ section.id }} {
    padding: 6px 0;
    min-height: auto;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-bar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
    gap: 1.6rem;
    flex-wrap: nowrap;
    position: relative;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-social {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-social .list-social {
    justify-content: flex-start;
    margin: 0;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-social .list-social__item .icon {
    width: 16px;
    height: 16px;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-social .list-social__link {
    padding: 0.4rem;
    height: auto;
    transition: opacity var(--duration-short, 0.25s) ease;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-social .list-social__link:hover {
    opacity: 0.8;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-messages {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4em 1.4em;
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  /* Dead-center the messages on the bar itself (not just on whatever
     room happens to be left), since that's what reads as "centered"
     to a visitor looking at the whole header — the reserved max-width
     just needs to clear the localization selector on the far right
     (now a single merged country/language control, not two), which is
     wider than the social icons on the left. */
  @media screen and (min-width: 750px) {
    .ss-announcement-{{ section.id }} .ss-announcement-messages {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      max-width: calc(100% - 46rem);
    }
  }

  .ss-announcement-{{ section.id }} .ss-announcement-messages__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-messages__item svg {
    width: 14px;
    height: 14px;
    display: inline-block;
    vertical-align: middle;
    fill: currentColor;
    flex-shrink: 0;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-localization {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
    padding-left: 1.2rem;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-localization .localization-selector {
    font-size: 1.1rem;
    padding: 0;
    gap: 0.3rem;
    min-height: 0;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-localization .localization-selector svg {
    width: 1rem;
    height: 1rem;
  }

  /* Below 750px, show just a flag + country code + currency ("🇵🇹 PT ·
     EUR") instead of the full "Country | CUR €" label, which is too
     wide for the limited space next to the trust-message marquee. */
  .ss-announcement-{{ section.id }} .localization-selector--abbreviate-mobile .localization-selector__label-full {
    display: none;
  }

  .ss-announcement-{{ section.id }} .localization-selector__label-abbrev {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .ss-announcement-{{ section.id }} .localization-selector__flag {
    display: block;
    flex-shrink: 0;
    border-radius: 0.2rem;
  }

  @media screen and (min-width: 750px) {
    .ss-announcement-{{ section.id }} .localization-selector--abbreviate-mobile .localization-selector__label-full {
      display: inline;
    }

    .ss-announcement-{{ section.id }} .localization-selector--abbreviate-mobile .localization-selector__label-abbrev {
      display: none;
    }
  }

  .ss-announcement-{{ section.id }} .ss-announcement-marquee {
    display: none;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-marquee__track {
    display: flex;
    width: max-content;
    animation: ss-announcement-marquee-{{ section.id }} 18s linear infinite;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-marquee__group {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    flex-shrink: 0;
    gap: 0.4em 1.4em;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    padding-right: 1.4em;
  }

  .ss-announcement-{{ section.id }} .ss-announcement-marquee__group .ss-announcement-messages__item svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  @keyframes ss-announcement-marquee-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-announcement-{{ section.id }} .ss-announcement-marquee__track {
      animation: none;
    }
  }

  /* Below 750px, the static messages are swapped for the scrolling
     marquee (full sentences don't fit next to the selector at this
     width): social icons stay on the left and the single merged
     selector on the right (its normal flex position, nothing
     pinned), and the marquee fills the actual room left between them
     via flex, rather than being symmetrically centered on the bar —
     centering it would cap its width to twice the *smaller* of the
     two gaps (the narrower selector side), wasting the slack on the
     wider social-icon side instead of giving it to the marquee. */
  @media screen and (max-width: 749px) {
    .ss-announcement-{{ section.id }} .ss-announcement-messages {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .ss-announcement-{{ section.id }} .ss-announcement-marquee {
      display: block;
      flex: 1 1 auto;
      min-width: 6rem;
      overflow: hidden;
    }

    /* Trim the social icons' and selector's own padding/gaps/font-size
       (not their position) to free up more width for the marquee,
       since neither is actually interactive content people need extra
       tap-target room around at this size. */
    .ss-announcement-{{ section.id }} .ss-announcement-social .list-social__link {
      padding: 0.1rem;
    }

    .ss-announcement-{{ section.id }} .ss-announcement-localization {
      padding-left: 0;
    }

    .ss-announcement-{{ section.id }} .ss-announcement-localization .localization-selector {
      font-size: 0.85rem;
      gap: 0.1rem;
      min-width: 0;
      width: auto;
    }

    /* .js .header-localization:not(.menu-drawer__localization)
       .localization-form__select in component-localization-form.css
       sets padding: 0 2.7rem 0 1.2rem (4 classes of specificity) on
       this exact button, which is what was leaving a visible dead gap
       between the text and the caret no matter what padding this
       file set on .localization-selector (3 classes) — out-specified
       it entirely. Matching it with one more class here beats it
       outright instead of relying on source-order luck. The caret
       itself is position: absolute (out of flow), so it needs *some*
       reserved right padding here to land next to the text instead of
       on top of it — just enough for the caret plus a small gap, not
       the original rule's much bigger 2.7rem. */
    .ss-announcement-{{ section.id }} .ss-announcement-localization .localization-form__select.localization-selector {
      padding: 0 1rem 0 0;
      width: auto;
    }

    .ss-announcement-{{ section.id }} .ss-announcement-localization .icon-caret {
      right: 0.2rem !important;
    }

    /* .header-localization:not(.menu-drawer__localization)
       .disclosure__list-wrapper in component-localization-form.css sets
       top: 100%; bottom: initial; right: 0 unconditionally (3 classes),
       which out-specifies this file's own mobile bottom-sheet rule
       (.disclosure__list-wrapper.country-selector, 2 classes, sets
       bottom: -1rem). The announcement bar carries .header-localization
       (needed elsewhere, see the padding override above), so on mobile
       the panel was opening pinned top: 100% of the *viewport* (it's
       position: fixed) — i.e. just off the bottom edge of the screen,
       behind the dark overlay, with nothing visible to tap. Restore the
       bottom-sheet position at higher specificity than that rule. */
    .ss-announcement-{{ section.id }} .ss-announcement-localization .localization-form .disclosure__list-wrapper {
      top: initial;
      bottom: -1rem;
      right: initial;
      left: 0;
    }

    .ss-announcement-{{ section.id }} .localization-selector__label-abbrev {
      gap: 0.3rem;
    }

    .ss-announcement-{{ section.id }} .ss-announcement-localization .localization-selector svg {
      width: 0.65rem;
      height: 0.65rem;
    }

    /* One extra class of specificity vs. the generic svg rule above
       (which, being `... .localization-selector svg`, actually out-
       specifies a plain `.localization-selector__flag` class rule —
       a type selector counts as a specificity tie-breaker above a
       rule with one fewer class) so the flag can be sized up on its
       own without the caret following it. */
    .ss-announcement-{{ section.id }} .ss-announcement-localization .localization-selector .localization-selector__flag {
      width: 0.9rem;
      height: 0.9rem;
    }
  }
{% endstyle %}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- capture announcement_items -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.text != blank -%}
      <span class="ss-announcement-messages__item">
        {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
          {{- block.settings.icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="link link--text" tabindex="-1">{{ block.settings.text | escape }}</a>
        {%- else -%}
          {{ block.settings.text | escape }}
        {%- endif -%}
      </span>
    {%- endif -%}
  {%- endfor -%}
  {%- if section.settings.trust_message_shipping != blank -%}
    <span class="ss-announcement-messages__item">
      {{- 'icon-box.svg' | inline_asset_content -}}
      {{ section.settings.trust_message_shipping | escape }}
    </span>
  {%- endif -%}
  {%- if section.settings.trust_message_secure != blank -%}
    <span class="ss-announcement-messages__item">
      {{- 'icon-lock.svg' | inline_asset_content -}}
      {{ section.settings.trust_message_secure | escape }}
    </span>
  {%- endif -%}
  {%- if section.settings.trust_message_returns != blank -%}
    <span class="ss-announcement-messages__item">
      {{- 'icon-return.svg' | inline_asset_content -}}
      {{ section.settings.trust_message_returns | escape }}
    </span>
  {%- endif -%}
{%- endcapture -%}

<div
  class="utility-bar ss-announcement-{{ section.id }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} utility-bar--bottom-border{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
>
  <div class="ss-announcement-bar__inner">
    <div class="ss-announcement-social">
      {%- if section.settings.show_social and social_icons -%}
        {%- render 'social-icons' -%}
      {%- endif -%}
    </div>
    <div class="ss-announcement-messages" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <span class="ss-announcement-messages__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
              {{- block.settings.icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="link link--text">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.trust_message_shipping != blank -%}
        <span class="ss-announcement-messages__item">
          {{- 'icon-box.svg' | inline_asset_content -}}
          {{ section.settings.trust_message_shipping | escape }}
        </span>
      {%- endif -%}
      {%- if section.settings.trust_message_secure != blank -%}
        <span class="ss-announcement-messages__item">
          {{- 'icon-lock.svg' | inline_asset_content -}}
          {{ section.settings.trust_message_secure | escape }}
        </span>
      {%- endif -%}
      {%- if section.settings.trust_message_returns != blank -%}
        <span class="ss-announcement-messages__item">
          {{- 'icon-return.svg' | inline_asset_content -}}
          {{ section.settings.trust_message_returns | escape }}
        </span>
      {%- endif -%}
    </div>
    <div class="ss-announcement-marquee" aria-hidden="true">
      <div class="ss-announcement-marquee__track">
        <div class="ss-announcement-marquee__group">{{ announcement_items }}</div>
        <div class="ss-announcement-marquee__group">{{ announcement_items }}</div>
      </div>
    </div>
    {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
      <div class="ss-announcement-localization">
        <localization-form>
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
            {%- render 'country-localization',
              localPosition: 'AnnouncementCountry',
              abbreviate_mobile: true,
              merge_locale: true
            -%}
          {%- endform -%}
        </localization-form>
      </div>
      <script>
        (function () {
          var pendingLocale;
          try {
            pendingLocale = sessionStorage.getItem('ssPendingLocale');
            sessionStorage.removeItem('ssPendingLocale');
          } catch (e) {
            return;
          }
          if (!pendingLocale || pendingLocale === document.documentElement.lang) return;

          var form = document.createElement('form');
          form.method = 'post';
          form.action = window.location.pathname + '/localization';
          form.hidden = true;
          var fields = {
            form_type: 'localization',
            utf8: '✓',
            _method: 'put',
            return_to: window.location.pathname + window.location.search,
            locale_code: pendingLocale,
          };
          for (var name in fields) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = fields[name];
            form.appendChild(input);
          }
          document.body.appendChild(form);
          form.submit();
        })();
      </script>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },    
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },  
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
         "content": "t:sections.announcement-bar.settings.paragraph.content"
    },             
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "header",
      "content": "Mensagens de confiança"
    },
    {
      "type": "text",
      "id": "trust_message_shipping",
      "label": "Mensagem de envio",
      "default": "Envios gratuitos"
    },
    {
      "type": "text",
      "id": "trust_message_secure",
      "label": "Mensagem de pagamento seguro",
      "default": "Pagamento seguro"
    },
    {
      "type": "text",
      "id": "trust_message_returns",
      "label": "Mensagem de devoluções",
      "default": "Devoluções simples"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "none", "label": "Nenhum" },
            { "value": "leather", "label": "Pele/Couro" },
            { "value": "box", "label": "Envio" },
            { "value": "lock", "label": "Pagamento seguro" },
            { "value": "return", "label": "Devolução" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
