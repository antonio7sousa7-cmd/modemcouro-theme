{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .main-page-title {
    text-align: center !important;
    font-size: 2.6rem !important;
    margin-bottom: 2rem !important;
  }

  @media screen and (min-width: 750px) {
    .main-page-title {
      font-size: 4rem !important;
      margin-bottom: 3rem !important;
    }
  }

  /* Harmoniza o corpo da página com o título, que é sempre centrado: o
     texto descritivo e as listas (ex.: morada, telemóvel) passam a
     centrar-se também, em vez de ficarem alinhados à esquerda por baixo
     de um título centrado. Escopado a #MainPage-{{ section.id }} — .rte
     é a classe genérica de texto rico do tema, usada noutras secções
     (artigos, descrição de produto, etc.) onde não deve ser tocada. */
  #MainPage-{{ section.id }} .rte {
    text-align: center;
  }

  /* Mais respiração entre parágrafos e antes/depois de listas (ex.: a
     lista de Morada/Telemóvel), para o texto não parecer um bloco denso.
     .rte > *:first-child/:last-child (base.css) zera as pontas, por isso
     isto só afeta os espaços realmente entre elementos. */
  #MainPage-{{ section.id }} .rte p {
    margin: 0 0 1.8rem;
  }

  #MainPage-{{ section.id }} .rte ul,
  #MainPage-{{ section.id }} .rte ol {
    margin: 2rem 0;
    padding-left: 0;
    list-style-position: inside;
  }

  #MainPage-{{ section.id }} .rte li {
    margin-bottom: 0.8rem;
  }
{%- endstyle -%}

<div id="MainPage-{{ section.id }}" class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
