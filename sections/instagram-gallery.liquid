{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-padding h2 {
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.03em;
    font-size: 22px;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding h2 {
      font-size: 26px;
    }
  }

  #InstagramGallery-{{ section.id }} .title-wrapper-with-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__list {
    gap: var(--grid-mobile-vertical-spacing) var(--grid-mobile-horizontal-spacing);
  }

  @media screen and (min-width: 750px) {
    #InstagramGallery-{{ section.id }} .instagram-gallery__list {
      gap: var(--grid-desktop-vertical-spacing) var(--grid-desktop-horizontal-spacing);
    }
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__item-link {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__item-link img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long, 0.5s) ease;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__item-link:hover img {
    transform: scale(1.04);
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0);
    opacity: 0;
    transition: opacity var(--duration-short) ease, background-color var(--duration-short) ease;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__icon svg {
    width: 2.4rem;
    height: 2.4rem;
    fill: #ffffff;
  }

  #InstagramGallery-{{ section.id }} .instagram-gallery__item-link:hover .instagram-gallery__icon {
    opacity: 1;
    background: rgba(0, 0, 0, 0.25);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div id="InstagramGallery-{{ section.id }}" class="instagram-gallery page-width section-{{ section.id }}-padding isolate">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.instagram_url != blank -%}
          <a
            href="{{ section.settings.instagram_url }}"
            class="link underlined-link"
            target="_blank"
            rel="noopener"
          >
            {{ section.settings.instagram_label | default: 'Seguir' }}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <ul
      class="instagram-gallery__list grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- assign post_link = block.settings.link | default: section.settings.instagram_url -%}
        <li class="instagram-gallery__item grid__item" {{ block.shopify_attributes }}>
          <a
            href="{{ post_link | default: '#' }}"
            class="instagram-gallery__item-link"
            {% if post_link != blank %}
              target="_blank"
              rel="noopener"
            {% endif %}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 500
                | image_tag:
                  loading: 'lazy',
                  widths: '250, 350, 500',
                  sizes: '(min-width: 990px) 20vw, 33vw'
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="instagram-gallery__icon">
              {{- 'icon-instagram.svg' | inline_asset_content -}}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Instagram",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Siga-nos no Instagram",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeno" },
        { "value": "h1", "label": "Médio" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h2",
      "label": "Tamanho do título"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Link do perfil de Instagram"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Texto do link",
      "default": "Seguir"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Colunas no desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "2", "label": "2 colunas" },
        { "value": "3", "label": "3 colunas" }
      ],
      "default": "3",
      "label": "Colunas no telemóvel"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Publicação",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (opcional)",
          "info": "Se vazio, usa o link do perfil definido acima"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
