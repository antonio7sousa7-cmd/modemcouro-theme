{%- comment -%}
  Renders one floating product card for the "Look Editorial" carousel
  (sections/editorial-shop-the-look.liquid). Outputs nothing when
  `product` is blank, so a look block can leave any of its product
  slots empty without special-casing in the section.

  Accepts:
  - product: {Product}
{%- endcomment -%}

{%- if product != blank -%}
  <a href="{{ product.url }}" class="editorial-look__card">
    <div class="editorial-look__card-media">
      {%- if product.featured_image != blank -%}
        {%- assign product_alt = product.featured_image.alt | default: product.title | strip_html -%}
        {{
          product.featured_image
          | image_url: width: 200
          | image_tag: loading: 'lazy', widths: '100, 160, 200', alt: product_alt
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="editorial-look__card-info">
      <p class="editorial-look__card-title">{{ product.title | escape }}</p>
      {% render 'price', product: product %}

      {%- if product.metafields.reviews.rating.value != blank -%}
        {%- liquid
          assign rating_decimal = 0
          assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
          if decimal >= 0.3 and decimal <= 0.7
            assign rating_decimal = 0.5
          elsif decimal > 0.7
            assign rating_decimal = 1
          endif
        -%}
        <div class="editorial-look__card-rating">
          <div
            class="rating"
            role="img"
            aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
          >
            <span
              aria-hidden="true"
              class="rating-star"
              style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
            ></span>
          </div>
          <span class="rating-count caption">
            <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
            <span class="visually-hidden">
              {{- product.metafields.reviews.rating_count }}
              {{ 'accessibility.total_reviews' | t -}}
            </span>
          </span>
        </div>
      {%- endif -%}
    </div>
  </a>
{%- endif -%}
