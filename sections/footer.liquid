{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ss-mega-footer-{{ section.id }} {
    --ss-footer-text: rgba(var(--color-foreground), 0.85);
    --ss-footer-text-strong: rgb(var(--color-foreground));
  }

  /* Remove a linha divisória entre os menus e a zona de copyright, e
     reduz o espaço vertical entre as duas zonas (era 5rem/3rem no fundo
     dos menus + 3rem/0 no topo do copyright, em desktop/mobile). */
  .ss-mega-footer-{{ section.id }} .footer__content-top {
    padding-bottom: 1.5rem;
  }

  .ss-mega-footer-{{ section.id }} .footer__content-bottom {
    border-top: none !important;
  }

  @media screen and (min-width: 750px) {
    .ss-mega-footer-{{ section.id }} .footer__content-top {
      padding-bottom: 2rem;
    }

    .ss-mega-footer-{{ section.id }} .footer__content-bottom {
      padding-top: 1.5rem;
    }
  }

  .ss-mega-footer-{{ section.id }} .ss-mega-footer {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    padding-bottom: 4rem;
  }

  .ss-mega-footer-{{ section.id }} a {
    color: var(--ss-footer-text);
    text-decoration: none;
  }

  .ss-mega-footer-{{ section.id }} a:hover {
    color: var(--ss-footer-text-strong);
    text-decoration: underline;
  }

  /* O botão de preferências de cookies é um <button>, não um <a>, por isso
     não é apanhado pela regra "a" acima. Replica aqui exatamente o mesmo
     comportamento (cor e sublinhado só no hover) para que se comporte como
     mais um link nativo do menu, mesmo que o script de privacidade do
     Shopify tente forçar o seu próprio estilo diretamente no elemento. */
  .ss-mega-footer-{{ section.id }} .ss-footer-cookie-preferences {
    color: var(--ss-footer-text) !important;
    text-decoration: none !important;
    /* Um <button> nativo traz padding/border do próprio browser que um <a>
       não tem, o que o desalinhava ligeiramente à direita dos restantes
       links. Substitui essa caixa pela mesma usada pelos links irmãos
       (.ss-footer-linklist__list a, acima: padding: 0.6rem 0). */
    display: inline-block;
    padding: 0.6rem 0 !important;
    margin: 0 !important;
    border: none !important;
    background: transparent !important;
    text-align: left !important;
    /* Nota: usar o atalho "font: inherit" aqui foi o que causou o bug
       anterior (letra maior, quebra de linha) — o atalho reinicia também o
       font-size, herdando-o do <li> pai em vez do 1.4rem explícito que
       ".link" já define. Por isso os valores tipográficos vão explícitos,
       um a um, iguais aos que ".link"/".link--text" já aplicam ao <a>. */
    font-family: inherit !important;
    font-size: 1.4rem !important;
    font-weight: normal !important;
    line-height: inherit !important;
    letter-spacing: inherit !important;
    white-space: nowrap !important;
  }

  .ss-mega-footer-{{ section.id }} .ss-footer-cookie-preferences:hover {
    color: var(--ss-footer-text-strong) !important;
    text-decoration: underline !important;
  }

  .ss-mega-footer-{{ section.id }} .ss-mega-footer__block-heading {
    margin: 0 0 1.6rem;
    color: var(--ss-footer-text-strong);
    font-size: 1.3rem;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
    font-weight: 700;
  }

  /* Top row: centered logo + slogan, full width above the menu columns */
  .ss-mega-footer-{{ section.id }} .ss-footer-brand-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 3.6rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-footer-brand__logo {
    display: block;
    margin-bottom: 1.6rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-footer-brand__logo img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .ss-mega-footer-{{ section.id }} .ss-footer-brand__slogan {
    margin: 0 auto;
    color: var(--ss-footer-text);
    font-size: 1.4rem;
    line-height: 1.6;
    max-width: 32rem;
  }

  /* Left column: trust badges */

  .ss-mega-footer-{{ section.id }} .ss-trust-badges {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-trust-badge {
    display: flex;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-trust-badge__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    color: var(--ss-footer-text-strong);
  }

  .ss-mega-footer-{{ section.id }} .ss-trust-badge__icon img,
  .ss-mega-footer-{{ section.id }} .ss-trust-badge__icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    fill: currentColor;
  }

  .ss-mega-footer-{{ section.id }} .ss-trust-badge__title {
    display: block;
    margin: 0;
    color: var(--ss-footer-text-strong);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-trust-badge__subtitle {
    display: block;
    margin: 0.3rem 0 0;
    color: var(--ss-footer-text);
    font-size: 1.3rem;
    line-height: 1.4;
  }

  /* Right column: mega menu row + bottom 4-col row */
  .ss-mega-footer-{{ section.id }} .ss-footer-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-mega-menu__heading {
    margin: 0 0 2.4rem;
    color: var(--ss-footer-text-strong);
    font-size: 1.5rem;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    font-weight: 700;
  }

  .ss-mega-footer-{{ section.id }} .ss-mega-menu__list,
  .ss-mega-footer-{{ section.id }} .ss-footer-linklist__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ss-mega-footer-{{ section.id }} .ss-mega-menu__list a,
  .ss-mega-footer-{{ section.id }} .ss-footer-linklist__list a {
    display: inline-block;
    padding: 0.6rem 0;
  }

  .ss-mega-footer-{{ section.id }} .ss-footer-bottom-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-footer-social__icons {
    margin-top: 0.4rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-footer-social__icons .list-social {
    justify-content: flex-start;
    margin-left: -1rem;
  }

  .ss-mega-footer-{{ section.id }} .ss-footer-payment {
    margin-top: 1.2rem;
  }

  @media screen and (min-width: 990px) {
    .ss-mega-footer-{{ section.id }} .ss-mega-footer {
      grid-template-columns: 25% 75%;
      gap: 6rem;
    }

    .ss-mega-footer-{{ section.id }} .ss-footer-bottom-row {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding ss-mega-footer-{{ section.id }}">
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif
  -%}
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'brand_trust' -%}
        {%- assign footer_logo = block.settings.logo | default: settings.logo -%}
        {%- if footer_logo != blank or block.settings.slogan != blank -%}
          <div class="ss-footer-brand-top page-width" {{ block.shopify_attributes }}>
            {%- if footer_logo != blank -%}
              <a href="{{ routes.root_url }}" class="ss-footer-brand__logo">
                {{
                  footer_logo
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', widths: '100, 150, 200, 300, 400', alt: shop.name
                }}
              </a>
            {%- endif -%}
            {%- if block.settings.slogan != blank -%}
              <p class="ss-footer-brand__slogan">{{ block.settings.slogan }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    <div class="ss-mega-footer page-width">
      <div class="ss-mega-footer__brand">
        {%- for block in section.blocks -%}
          {%- if block.type == 'brand_trust' -%}
            <div class="ss-footer-brand">
              <div class="ss-trust-badges">
                {%- for i in (1..3) -%}
                  {%- liquid
                    case i
                      when 1
                        assign badge_icon = block.settings.badge_1_icon
                        assign badge_title = block.settings.badge_1_title
                        assign badge_subtitle = block.settings.badge_1_subtitle
                        assign badge_fallback_icon = 'icon-leather.svg'
                      when 2
                        assign badge_icon = block.settings.badge_2_icon
                        assign badge_title = block.settings.badge_2_title
                        assign badge_subtitle = block.settings.badge_2_subtitle
                        assign badge_fallback_icon = 'icon-lock.svg'
                      when 3
                        assign badge_icon = block.settings.badge_3_icon
                        assign badge_title = block.settings.badge_3_title
                        assign badge_subtitle = block.settings.badge_3_subtitle
                        assign badge_fallback_icon = 'icon-return.svg'
                    endcase
                  -%}
                  {%- if badge_title != blank or badge_subtitle != blank -%}
                    <div class="ss-trust-badge">
                      <span class="ss-trust-badge__icon">
                        {%- if badge_icon != blank -%}
                          {{ badge_icon | image_url: width: 72 | image_tag: loading: 'lazy', alt: badge_title | escape }}
                        {%- else -%}
                          {{- badge_fallback_icon | inline_asset_content -}}
                        {%- endif -%}
                      </span>
                      <span>
                        {%- if badge_title != blank -%}
                          <span class="ss-trust-badge__title">{{ badge_title | escape }}</span>
                        {%- endif -%}
                        {%- if badge_subtitle != blank -%}
                          <span class="ss-trust-badge__subtitle">{{ badge_subtitle | escape }}</span>
                        {%- endif -%}
                      </span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="ss-footer-nav">
        {%- for block in section.blocks -%}
          {%- if block.type == 'mega_menu' -%}
            {%- if block.settings.heading != blank or block.settings.menu != blank -%}
              <div class="ss-mega-menu" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="ss-mega-menu__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="ss-mega-menu__list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="link link--text{% if link.active %} list-menu__item--active{% endif %}">
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="ss-footer-bottom-row">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'link_list' -%}
                <div class="ss-footer-linklist" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="ss-mega-footer__block-heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.menu != blank -%}
                    <ul class="ss-footer-linklist__list">
                      {%- for link in block.settings.menu.links -%}
                        <li>
                          <a href="{{ link.url }}" class="link link--text{% if link.active %} list-menu__item--active{% endif %}">
                            {{ link.title | escape }}
                          </a>
                        </li>
                      {%- endfor -%}
                      {%- if block.settings.heading == 'Empresa' -%}
                        <li>
                          <button
                            type="button"
                            class="link link--text ss-footer-cookie-preferences"
                            onclick="window.Shopify && window.Shopify.customerPrivacy && window.Shopify.customerPrivacy.showPreferences && window.Shopify.customerPrivacy.showPreferences()"
                          >
                            Preferências de cookies
                          </button>
                        </li>
                      {%- endif -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- when 'social_payments' -%}
                <div class="ss-footer-social-payments" {{ block.shopify_attributes }}>
                  {%- if block.settings.social_heading != blank -%}
                    <h2 class="ss-mega-footer__block-heading">{{ block.settings.social_heading | escape }}</h2>
                  {%- endif -%}
                  {%- if has_social_icons -%}
                    <div class="ss-footer-social__icons">
                      {%- render 'social-icons' -%}
                    </div>
                  {%- endif -%}
                  {%- if section.settings.payment_enable -%}
                    <div class="ss-footer-payment">
                      {%- if block.settings.payment_heading != blank -%}
                        <h2 class="ss-mega-footer__block-heading">{{ block.settings.payment_heading | escape }}</h2>
                      {%- endif -%}
                      <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
                      <ul class="ss-footer-payment__list list-payment" role="list">
                        <li class="list-payment__item">
                          {{ 'visa' | payment_type_svg_tag: class: 'icon icon--full-color' }}
                        </li>
                        <li class="list-payment__item">
                          {{ 'master' | payment_type_svg_tag: class: 'icon icon--full-color' }}
                        </li>
                        <li class="list-payment__item">
                          {{ 'icon-mbway.svg' | inline_asset_content }}
                        </li>
                        <li class="list-payment__item">
                          {{ 'icon-multibanco.svg' | inline_asset_content }}
                        </li>
                      </ul>
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div
    class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__column footer__localization isolate">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
    </div>
    <div class="footer__content-bottom-wrapper page-width{% if section.settings.enable_country_selector == false and section.settings.enable_language_selector == false %} footer__content-bottom-wrapper--center{% endif %}">
      <div class="footer__copyright caption">
        <small class="copyright__content"
          >&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url -}}
        </small>
        {%- comment -%}
          Links de políticas (Política de privacidade, Reembolso, Termos do
          serviço, etc.) removidos desta linha a pedido — mantém-se só o
          copyright. O separador visual entre eles desaparece junto, já que
          era aplicado ao <ul class="policies"> que aqui existia.
        {%- endcomment -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "brand_trust",
      "name": "Marca e Confiança",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logótipo",
          "info": "Se vazio, usa o logótipo definido em Definições do tema > Logótipo."
        },
        {
          "type": "richtext",
          "id": "slogan",
          "label": "Slogan",
          "default": "<p>Mais de 35 anos de experiência no fabrico de vestuário em couro.</p>"
        },
        {
          "type": "header",
          "content": "Selo 1"
        },
        {
          "type": "image_picker",
          "id": "badge_1_icon",
          "label": "Ícone"
        },
        {
          "type": "text",
          "id": "badge_1_title",
          "label": "Título",
          "default": "Fabrico Português"
        },
        {
          "type": "text",
          "id": "badge_1_subtitle",
          "label": "Subtítulo",
          "default": "Feito à mão em Portugal"
        },
        {
          "type": "header",
          "content": "Selo 2"
        },
        {
          "type": "image_picker",
          "id": "badge_2_icon",
          "label": "Ícone"
        },
        {
          "type": "text",
          "id": "badge_2_title",
          "label": "Título",
          "default": "Pagamento Seguro"
        },
        {
          "type": "text",
          "id": "badge_2_subtitle",
          "label": "Subtítulo",
          "default": "Transações encriptadas"
        },
        {
          "type": "header",
          "content": "Selo 3"
        },
        {
          "type": "image_picker",
          "id": "badge_3_icon",
          "label": "Ícone"
        },
        {
          "type": "text",
          "id": "badge_3_title",
          "label": "Título",
          "default": "Devoluções Simples"
        },
        {
          "type": "text",
          "id": "badge_3_subtitle",
          "label": "Subtítulo",
          "default": "Processo fácil e rápido"
        }
      ]
    },
    {
      "type": "mega_menu",
      "name": "Mega Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Recomendado: um menu dedicado apenas às coleções principais (ex.: Casacos, Malas, Vestidos)."
        }
      ]
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "social_payments",
      "name": "Comunidade e Pagamento",
      "settings": [
        {
          "type": "text",
          "id": "social_heading",
          "label": "Título (redes sociais)",
          "default": "Comunidade"
        },
        {
          "type": "text",
          "id": "payment_heading",
          "label": "Título (pagamento)",
          "default": "Pagamento Seguro"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label",
      "info": "t:sections.footer.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_language_selector.label",
      "info": "t:sections.footer.settings.enable_language_selector.info"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label",
      "info": "t:sections.footer.settings.show_policy.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
