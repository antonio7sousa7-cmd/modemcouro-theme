{%- comment -%}
  Secção de avaliações de clientes para a página de produto, com estética
  "silent luxury": fundo creme, cartões discretos com estrelas, citação em
  itálico e nome do cliente. As avaliações são blocos fixos (não ligados à
  app de reviews da Shopify) — os textos padrão vêm já escritos aqui e em
  templates/product*.json, e podem ser editados por produto no editor.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ProductReviews-{{ section.id }} .ss-reviews__heading {
    margin: 0 0 3rem;
    text-align: center;
    text-transform: uppercase;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 1.6rem;
    letter-spacing: 0.15em;
    color: rgb(var(--color-foreground));
  }

  /* Carrossel: scroll-snap nativo (arrasta com o dedo; o rato é tratado pelo
     script no fim do ficheiro). 1 cartão + "espreitadela" no telemóvel,
     2 em tablet, 3 em desktop. */
  #ProductReviews-{{ section.id }} .ss-reviews__list {
    --ss-gap: 1.6rem;
    --ss-visible: 1.15;
    display: flex;
    gap: var(--ss-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding-bottom: 0.4rem;
    cursor: grab;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__list::-webkit-scrollbar {
    display: none;
  }

  #ProductReviews-{{ section.id }} .ss-reviews__list.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  @media screen and (min-width: 750px) {
    #ProductReviews-{{ section.id }} .ss-reviews__list {
      --ss-gap: 2.4rem;
      --ss-visible: 2;
    }
  }

  @media screen and (min-width: 990px) {
    #ProductReviews-{{ section.id }} .ss-reviews__list {
      --ss-gap: 3rem;
      --ss-visible: 3;
    }
  }

  #ProductReviews-{{ section.id }} .ss-review-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((100% - var(--ss-gap) * (var(--ss-visible) - 1)) / var(--ss-visible));
    box-sizing: border-box;
    scroll-snap-align: start;
    padding: 2.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__stars {
    display: flex;
    gap: 0.2rem;
    margin-bottom: 1.4rem;
  }

  /* Estrela preenchida: o icon-star.svg do tema é só contorno (path evenodd
     com "buraco"), por isso aqui usa-se um svg sólido próprio. A classe --empty
     fica no <span> à volta do svg, daí o seletor descer até ao svg. */
  #ProductReviews-{{ section.id }} .ss-review-card__stars svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: #d4af37;
  }

  #ProductReviews-{{ section.id }} .ss-review-card__star--empty svg {
    fill: rgba(212, 175, 55, 0.25);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__quote {
    flex-grow: 1;
    margin: 0 0 1.6rem;
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground));
  }

  #ProductReviews-{{ section.id }} .ss-review-card__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: rgba(var(--color-foreground), 0.65);
  }

  #ProductReviews-{{ section.id }} .ss-review-card__verified {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.3rem;
    height: 1.3rem;
  }

  #ProductReviews-{{ section.id }} .ss-review-card__verified svg {
    width: 100%;
    height: 100%;
  }
{%- endstyle -%}

{%- capture star_svg -%}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.2l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L10 15l-5.6 3.3 1.4-6.3L1 7.7l6.4-.6z"/></svg>
{%- endcapture -%}

<div id="ProductReviews-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ss-reviews__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="ss-reviews__list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'review' -%}
            <div class="ss-review-card" {{ block.shopify_attributes }}>
              <div class="ss-review-card__stars" role="img" aria-label="{{ block.settings.rating }} de 5 estrelas">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    <span>{{ star_svg }}</span>
                  {%- else -%}
                    <span class="ss-review-card__star--empty">{{ star_svg }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <p class="ss-review-card__quote">&ldquo;{{ block.settings.review }}&rdquo;</p>
              <p class="ss-review-card__name">
                {{ block.settings.customer_name | escape }}
                <span class="ss-review-card__verified" role="img" aria-label="Comprador verificado">
                  {{- 'icon-tick.svg' | inline_asset_content -}}
                </span>
              </p>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var list = document.querySelector('#ProductReviews-{{ section.id }} .ss-reviews__list');
    if (!list) return;
    var startX = 0, startScroll = 0, down = false, moved = false;

    list.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return; // toque usa o scroll nativo
      down = true; moved = false;
      startX = e.clientX; startScroll = list.scrollLeft;
    });
    window.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) { moved = true; list.classList.add('is-dragging'); }
      if (moved) list.scrollLeft = startScroll - dx;
    });
    window.addEventListener('pointerup', function () {
      if (!down) return;
      down = false;
      list.classList.remove('is-dragging'); // o snap volta a assentar no cartão mais próximo
    });
    list.addEventListener('dragstart', function (e) { e.preventDefault(); });
  })();
</script>

{% schema %}
{
  "name": "Avaliações",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "O Que Dizem os Nossos Clientes"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avaliação",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Estrelas",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Texto da avaliação",
          "default": "Qualidade impressionante, recomendo."
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Nome do cliente",
          "default": "Cliente"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avaliações",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
